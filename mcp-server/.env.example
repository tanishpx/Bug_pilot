# Bug Pilot REST API. The MCP server is a client of this API and has no direct
# database connection of its own.
BUG_PILOT_API_URL=http://localhost:3001/api

# Optional bearer token for the API (when auth is enabled).
BUG_PILOT_API_KEY=

# Identity used for X-User-Id on MCP-originated requests.
BUG_PILOT_USER_ID=mcp-agent
