# Mode: 'database' (direct MongoDB connection, default) | 'bugpilot_api' (via REST API)
DATA_SOURCE_MODE=database

# MongoDB Atlas connection string (used in 'database' mode)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/bugpilot

# Bug Pilot REST API config (used in 'bugpilot_api' mode)
BUG_PILOT_API_URL=http://localhost:3001/api
BUG_PILOT_API_KEY=

