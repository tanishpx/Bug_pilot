{
  "name": "bugpilot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"node server/index.js\"",
    "dev:frontend": "vite",
    "dev:server": "node server/index.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "migrate": "node server/scripts/migrate.js",
    "db:migrate": "node server/scripts/migrate.js",
    "seed": "node server/scripts/seed.js",
    "db:seed": "node server/scripts/seed.js",
    "mcp:build": "npm --prefix mcp-server run build",
    "mcp:test": "npm --prefix mcp-server test",
    "mcp:start": "npm --prefix mcp-server start",
    "test": "node --test test/bugs.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.1",
    "firebase": "^12.18.0",
    "mongoose": "^9.9.4",
    "nanoid": "^5.0.9",
    "nodemailer": "^9.0.6",
    "prom-client": "^15.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.2.4",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
